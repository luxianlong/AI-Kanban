# Java / Maven — one per module of the aggregator build
target/
protocol/target/
server/target/
worker/target/
*.class

# H2 database files
server/data/
*.mv.db
*.trace.db
*.lock.db

# Uploaded task attachments (user data, lives beside the live database)
data/attachments/
server/data/attachments/

# Node / Vite
frontend/node_modules/
frontend/dist/

# Logs / OS / editor
*.log
.DS_Store
.idea/
.vscode/
*.iml

# Rotated pre-restart database backups (runtime state, never committed)
backups/

# Local script overrides (per-machine, per-session state)
scripts/local.env

